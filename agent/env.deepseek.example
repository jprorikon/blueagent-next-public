# 單人 / 多角色 鏈路的推薦部署設定（blueagent-next）
#
# 用法（金鑰不進命令行、不進 repo）：
#   BLUEAGENT_ENV_FILE=<放 DEEPSEEK_API_KEY 的 .env>   # 現役橋那把金鑰可直接沿用
#   BLUEAGENT_BRAIN=deepseek
#   ...
#
# 為什麼分開寫：`DEEPSEEK_API_KEY` 只放 `.secrets/deepseek.env`（600），
# 這個檔案只帶「行為參數」，可以進 repo、可以給別人看。

# ── 大腦：跟現役 blueagent 同一顆（DeepSeek）──────────────────────────────────
# 變數名刻意沿用現役橋：DEEPSEEK_BASE / DEEPSEEK_MODEL / DEEPSEEK_API_KEY / DEEPSEEK_THINKING。
# 新倉專屬的 BLUEAGENT_LLM_* 若有設，優先於上面那組。
BLUEAGENT_BRAIN=deepseek

# 思考強度：low ⇒ 閒聊 1–2 s（現役橋同值）。DeepSeek 不認 chat_template_kwargs，
# 只認 reasoning_effort ⇒ 由 DEEPSEEK_THINKING 帶進來。
# 注意：max_tokens 太小（<400）時思考可能吃掉全部額度、正文為空——新倉會自動重要一次，
#      但還是建議給 400 以上。
BLUEAGENT_LLM_MAX_TOKENS=400

# 首幀預算：DeepSeek 正常 1–2 s；但語音輪要等 TTS，留裕度。
BLUEAGENT_DEADLINE_MS=60000

# ── 語言：文字與聲音同一種語言 ───────────────────────────────────────────────
# 她的聲線是日文庫；語言一致性來自日語人格檔（agent/persona/SOUL.md），
# 這兩個是保險：後綴把要求掛在最後一句用戶訊息、語言閘會把中文整輪丟掉重寫。
BLUEAGENT_SPEAK_LANG=ja

# ── 人格檔位置（預設＝repo 內 agent/persona，通常不用設）───────────────────────
# BLUEAGENT_SOUL_DIR=/path/to/soul

# ── 聲音：包現役橋的 ba/voice（實例池、熱機親和、片假名正規化全照舊）──────────
# BLUEAGENT_TTS=bridge
# BLUEAGENT_TTS_BRIDGE_ROOT=<含 ba/voice 的橋 repo>
# TTS_ASSETS=<app 的 assets（含 voices/<角色>/refs.json）>
# TTS_POOL="http://<tts1>|<該機參考音根>;http://<tts2>|<該機參考音根>"
# TTS_REMOTE_ROOT=<兜底參考音根>
# TTS_TEXT_LANG=ja        # 鎖 ja（owner 2026-10-21 定），不逐句改判
