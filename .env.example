# 离线演示（默认，无需密钥）
BLUEAGENT_BRAIN=mock
BLUEAGENT_SPEAK_LANG=ja

# 连接 OpenAI 兼容端点时，改为 openai 并取消下面三行注释。
# BLUEAGENT_BRAIN=openai
# BLUEAGENT_LLM_BASE_URL=https://api.example.com/v1
# BLUEAGENT_LLM_MODEL=your-model
# BLUEAGENT_LLM_API_KEY=replace-with-your-own-key

# 可选外部服务均默认关闭或留空。
# DISCORD_BOT_TOKEN=
# TTS_TOKEN=
# BLUEAGENT_APP_KICK_TOKEN=
# BLUEAGENT_APP_VOICE_TOKEN=
